#!/bin/sh
set -eu

CONFIG_DIR="${BIFROST_GENERATED_CONFIG_DIR:-/run/bifrost}"
SERVER_CONFIG="$CONFIG_DIR/server.yaml"
CLIENT_CONFIG="$CONFIG_DIR/client.yaml"
HOOK_PATH="/usr/local/share/bifrost/accept-json.sh"

die() {
  echo "bifrost-entrypoint: $*" >&2
  exit 2
}

usage() {
  cat >&2 <<'EOF'
usage: bifrost-entrypoint <server|client|ctl> [args...]

  server [--config path]  generate server config unless --config is provided
  client [--config path]  generate client config unless --config is provided
  ctl [args...]           run bifrostctl
EOF
}

has_config_arg() {
  for arg in "$@"; do
    case "$arg" in
      --config|--config=*)
        return 0
        ;;
    esac
  done
  return 1
}

has_help_arg() {
  for arg in "$@"; do
    case "$arg" in
      -h|--help|-help)
        return 0
        ;;
    esac
  done
  return 1
}

require_env() {
  name="$1"
  eval "value=\${$name:-}"
  if [ -z "$value" ]; then
    die "$name is required"
  fi
}

parse_bool() {
  name="$1"
  value="$2"
  lower="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    ""|0|false|no)
      printf 'false'
      ;;
    1|true|yes)
      printf 'true'
      ;;
    *)
      die "$name must be a boolean value"
      ;;
  esac
}

validate_headers_json() {
  headers_json="$1"
  if ! printf '%s' "$headers_json" | jq -e 'type == "object" and all(.[]; type == "string")' >/dev/null; then
    die "BIFROST_CLIENT_HEADERS_JSON must be a JSON object with string values"
  fi
  if printf '%s' "$headers_json" | jq -e 'any(keys[]; ascii_downcase == "x-bifrost-token")' >/dev/null; then
    die "BIFROST_CLIENT_HEADERS_JSON must not contain X-Bifrost-Token; use BIFROST_CLIENT_TOKEN"
  fi
}

generate_server_config() {
  mkdir -p "$CONFIG_DIR"

  jq -n \
    --arg listen "${BIFROST_SERVER_LISTEN:-:8443}" \
    --arg cert_file "${BIFROST_SERVER_TLS_CERT_FILE:-/certs/server.crt}" \
    --arg key_file "${BIFROST_SERVER_TLS_KEY_FILE:-/certs/server.key}" \
    --arg clients_file "${BIFROST_ACCEPT_CLIENTS_FILE:-/etc/bifrost/clients.json}" \
    --arg prefixes "${BIFROST_LISTENER_ALLOWED_UNIX_PREFIXES:-/sockets}" \
    --arg admin_listen "${BIFROST_ADMIN_LISTEN:-}" \
    --arg log_level "${BIFROST_LOG_LEVEL:-info}" \
    --arg log_format "${BIFROST_LOG_FORMAT:-text}" \
    --arg hook_path "$HOOK_PATH" \
    '
      def csv:
        split(",")
        | map(gsub("^\\s+|\\s+$"; ""))
        | map(select(length > 0));

      {
        server: {
          listen: $listen,
          tls: {
            cert_file: $cert_file,
            key_file: $key_file
          }
        },
        accept_hook: {
          command: $hook_path,
          args: ["--clients", $clients_file]
        },
        listener_policy: {
          allowed_unix_prefixes: ($prefixes | csv)
        },
        logging: {
          level: $log_level,
          format: $log_format
        }
      }
      + (if $admin_listen == "" then {} else {admin: {listen: $admin_listen}} end)
    ' > "$SERVER_CONFIG"

  printf '%s\n' "$SERVER_CONFIG"
}

generate_client_config() {
  require_env BIFROST_CLIENT_SERVER_URL
  require_env BIFROST_CLIENT_TARGET_ADDRESS
  require_env BIFROST_CLIENT_TOKEN

  mkdir -p "$CONFIG_DIR"

  headers_json="${BIFROST_CLIENT_HEADERS_JSON:-}"
  if [ -z "$headers_json" ]; then
    headers_json="{}"
  fi
  validate_headers_json "$headers_json"
  insecure_skip_verify="$(parse_bool BIFROST_CLIENT_TLS_INSECURE_SKIP_VERIFY "${BIFROST_CLIENT_TLS_INSECURE_SKIP_VERIFY:-false}")"

  jq -n \
    --arg server_url "$BIFROST_CLIENT_SERVER_URL" \
    --arg target_address "$BIFROST_CLIENT_TARGET_ADDRESS" \
    --arg ca_file "${BIFROST_CLIENT_TLS_CA_FILE:-/certs/ca.crt}" \
    --arg server_name "${BIFROST_CLIENT_TLS_SERVER_NAME:-}" \
    --arg token "$BIFROST_CLIENT_TOKEN" \
    --argjson extra_headers "$headers_json" \
    --argjson insecure_skip_verify "$insecure_skip_verify" \
    --arg admin_listen "${BIFROST_ADMIN_LISTEN:-}" \
    --arg log_level "${BIFROST_LOG_LEVEL:-info}" \
    --arg log_format "${BIFROST_LOG_FORMAT:-text}" \
    '
      {
        client: {
          server_url: $server_url,
          headers: ($extra_headers + {"X-Bifrost-Token": $token}),
          target: {
            type: "tcp",
            address: $target_address
          },
          tls: (
            {
              ca_file: $ca_file,
              insecure_skip_verify: $insecure_skip_verify
            }
            + (if $server_name == "" then {} else {server_name: $server_name} end)
          )
        },
        logging: {
          level: $log_level,
          format: $log_format
        }
      }
      + (if $admin_listen == "" then {} else {admin: {listen: $admin_listen}} end)
    ' > "$CLIENT_CONFIG"

  printf '%s\n' "$CLIENT_CONFIG"
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

role="$1"
shift

case "$role" in
  server)
    if has_config_arg "$@" || has_help_arg "$@"; then
      exec bifrost-server "$@"
    fi
    generated_config="$(generate_server_config)"
    exec bifrost-server --config "$generated_config" "$@"
    ;;
  client)
    if has_config_arg "$@" || has_help_arg "$@"; then
      exec bifrost-client "$@"
    fi
    generated_config="$(generate_client_config)"
    exec bifrost-client --config "$generated_config" "$@"
    ;;
  ctl)
    exec bifrostctl "$@"
    ;;
  *)
    usage
    die "unknown role $role"
    ;;
esac
